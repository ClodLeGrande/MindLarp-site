# Application
NODE_ENV=development
HOST=0.0.0.0
PORT=5173
PUBLIC_URL=http://localhost:5173
DATA_FILE=./data/mindlarp.json

# OpenAI-compatible model inference
MINDLARP_UPSTREAM_URL=
MINDLARP_UPSTREAM_KEY=

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub OAuth
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Stripe billing
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=

# SMTP email / password recovery
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="MindLarp <no-reply@mindlarp.ai>"
