# Application
NODE_ENV=development
HOST=0.0.0.0
PORT=5173
PUBLIC_URL=http://localhost:5173

# PostgreSQL / local Docker database
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
DIRECT_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
POSTGRES_DB=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=54322
# DATABASE_SSL=false
# DATABASE_SSL_REJECT_UNAUTHORIZED=true
# DATABASE_POOL_SIZE=10
# DATABASE_QUERY_TIMEOUT=15000
# DATABASE_STATEMENT_TIMEOUT=15000
# DATABASE_LOCK_TIMEOUT=5000

# Supabase: use the pooler for DATABASE_URL and the direct connection for DIRECT_URL.
# Keep the secret key server-side. No browser access or public RLS policies are enabled.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Optional JSON fallback used only when DATABASE_URL is empty
DATA_FILE=./data/mindlarp.json

# Indicative USD→RUB conversion rate shown next to plan prices (default 90).
# Billing is always charged in USD; ruble amounts are approximate.
USD_TO_RUB=90

# OpenAI-compatible model inference
MINDLARP_UPSTREAM_URL=
MINDLARP_UPSTREAM_KEY=
# Development-only: production requires an active subscription unless explicitly overridden.
ALLOW_INFERENCE_WITHOUT_SUBSCRIPTION=true
INFERENCE_DAILY_REQUEST_LIMIT=100

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub OAuth
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Discord OAuth
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# External chat interface. The built-in /chat page was removed; when set,
# Chat links (console sidebar and public CTAs) point to this URL.
CHAT_URL=

# Stripe billing
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=

# Subscription plans (Pro $19/mo, Plus $79/mo, Studio $199/mo).
# Payment links: Stripe Dashboard → Product catalog → Payment links → create one
# per plan, then paste the https://buy.stripe.com/... URL here. Buttons on
# /pricing and Console → Billing stay disabled until a link is set.
STRIPE_PAYMENT_LINK_PRO=
STRIPE_PAYMENT_LINK_PLUS=
STRIPE_PAYMENT_LINK_STUDIO=
# Price IDs of the same plans (price_...). Required for webhook entitlements:
# they tell the webhook which subscriptions belong to which plan.
STRIPE_PRICE_ID_PRO=
STRIPE_PRICE_ID_PLUS=
STRIPE_PRICE_ID_STUDIO=
# Optional per-plan daily request limits (defaults: 500 / 2500 / 10000).
INFERENCE_DAILY_REQUEST_LIMIT_PRO=
INFERENCE_DAILY_REQUEST_LIMIT_PLUS=
INFERENCE_DAILY_REQUEST_LIMIT_STUDIO=

# SMTP email / password recovery
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
# Defaults to true in production. Plaintext is allowed only for a local test relay.
SMTP_REQUIRE_TLS=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM="MindLarp <no-reply@mindlarp.ai>"
